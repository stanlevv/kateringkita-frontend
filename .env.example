# ========================================================
# KateringKita Frontend - Environment Variables Configuration
# ========================================================

# --------------------------------------------------------
# 1. API Backend Configuration
# --------------------------------------------------------
# Opsi A: Mode Production (Live Backend Heroku)
NEXT_PUBLIC_API_URL=https://ketring-45f82aef1ca0.herokuapp.com/api
BACKEND_API_URL=https://ketring-45f82aef1ca0.herokuapp.com/api

# Opsi B: Mode Pengembangan Lokal (Jika menjalankan backend di localhost:5000)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# BACKEND_API_URL=http://localhost:5000/api

# --------------------------------------------------------
# 2. Cloudflare R2 Object Storage (S3-Compatible API)
# --------------------------------------------------------
# Didapatkan dari Dashboard Cloudflare > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kateringkita-menu
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
