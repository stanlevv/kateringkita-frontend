# ========================================================
# KateringKita Frontend - Environment Variables Configuration
# ========================================================

# --------------------------------------------------------
# 1. API Backend Configuration
# --------------------------------------------------------
BACKEND_API_URL=http://localhost:5000/api/v1

# Opsional. Rahasia bersama dengan API (isi sama dengan INTERNAL_API_SECRET di be/.env, minimal 32 karakter)
# agar batas percobaan masuk dihitung per alamat pengunjung. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_API_SECRET=
